# OrangIdentifier .gitignore
# Photos, crops, and model weights are NOT versioned.
# Heavy assets are hosted on Hugging Face: https://huggingface.co/tit0000/OrangIdentifier
# Download models with: python models/download_models.py

# Data (photos, crops — never in the repo)
data/photos/
data/wild_images/raw/*
data/crops/known/
data/crops/bos/
data/crops/new/
data/crops/wild/
data/yolo_dataset/
data/yolo_dataset_split/
data/crops.json

# Keep empty folder structure and the wild images instructions
!data/**/.gitkeep
!data/wild_images/raw/README.md

# Model weights (too large — hosted on HuggingFace)
models/*.pt
models/*.pth
models/*.tflite
models/.cache/

# Training outputs
output/
runs/

# HuggingFace / PyTorch caches (if redirected inside the repo)
HuggingFaceCache/
TorchCache/
hf_cache/
torch_cache/

# Python
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/
.env/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo

# Temporary / atomic write artifacts
*.tmp
*.bak

# Logs
*.log
benchmark_log.txt
